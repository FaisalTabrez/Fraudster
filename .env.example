# Public web port for Docker Compose
WEB_PORT=4173

# Gateway-to-service URLs inside Docker Compose
TEXT_SERVICE_URL=http://text:8000
URL_SERVICE_URL=http://url:8000
OCR_SERVICE_URL=http://ocr:8000

# Runtime policy
ANALYSIS_TIMEOUT_SECONDS=10
DEMO_MODE=false

# Text adapter configuration. Leave the key empty until the adapter is installed.
TEXT_MODEL=configure-me
TEXT_API_KEY=
